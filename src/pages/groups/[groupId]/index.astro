---
import GroupLayout from "@/layouts/GroupLayout.astro";
import { DashboardTab } from "@/components/group/DashboardTab";
import type { AuthUserWithProfile } from "@/types";

// Server-side authentication check
const user = Astro.locals.user as AuthUserWithProfile;
if (!user) {
  return Astro.redirect("/login");
}

const { groupId } = Astro.params;
if (!groupId) {
  return Astro.redirect("/");
}

// Fetch group details for SSR
const response = await fetch(`${Astro.url.origin}/api/groups/${groupId}`, {
  headers: {
    Cookie: Astro.request.headers.get("cookie") || "",
  },
});

if (!response.ok) {
  if (response.status === 404 || response.status === 403) {
    return Astro.redirect("/");
  }
  throw new Error("Failed to fetch group details");
}

const groupDetails = await response.json();
---

<GroupLayout groupId={groupId} user={user} groupDetails={groupDetails}>
  <DashboardTab client:load groupId={groupId} userId={user.id} userRole={groupDetails.my_role} />
</GroupLayout>
